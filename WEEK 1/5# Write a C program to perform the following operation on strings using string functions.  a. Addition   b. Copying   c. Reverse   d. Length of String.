#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100], str3[100];
    char temp[100];

    printf("Enter first string: ");
    gets(str1);
    printf("Enter second string: ");
    gets(str2);

    strcpy(temp, str1);         
    strcat(temp, str2);         
    printf("\nAddition (Concatenation): %s\n", temp);

    strcpy(str3, str1);          
    printf("Copying str1 into str3: %s\n", str3);

    strcpy(temp, str1);          
    strrev(temp);                
    printf("Reverse of str1: %s\n", temp);

    printf("Length of str1: %d\n", (int)strlen(str1));
    printf("Length of str2: %d\n", (int)strlen(str2));

    return 0;
}
