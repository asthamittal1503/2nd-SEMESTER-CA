#include <stdio.h>
#include <ctype.h>
#include <string.h>

// -------- Integer Sorts --------
void insertionSort(int arr[], int n) {
    for(int i = 1; i < n; i++) {
        int key = arr[i], j = i - 1;
        while(j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

void selectionSort(int arr[], int n) {
    for(int i = 0; i < n - 1; i++) {
        int min = i;
        for(int j = i + 1; j < n; j++) {
            if(arr[j] < arr[min])
                min = j;
        }
        int temp = arr[i];
        arr[i] = arr[min];
        arr[min] = temp;
    }
}

// -------- Character Sorts --------
void bubbleSort(char arr[], int n) {
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(arr[j] > arr[j + 1]) {
                char temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void quickSort(char arr[], int low, int high) {
    if(low < high) {
        char pivot = arr[low];
        int i = low, j = high;
        char temp;

        while(i < j) {
            while(arr[i] <= pivot && i < high) i++;
            while(arr[j] > pivot) j--;

            if(i < j) {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }

        temp = arr[low];
        arr[low] = arr[j];
        arr[j] = temp;

        quickSort(arr, low, j - 1);
        quickSort(arr, j + 1, high);
    }
}

// -------- Main --------
int main() {
    char input[100];
    printf("Enter elements (space separated):\n");
    fgets(input, sizeof(input), stdin);

    // Check if input is integer type
    int isInteger = 1;
    for(int i = 0; input[i] != '\0'; i++) {
        if(input[i] != ' ' && input[i] != '\n' && !isdigit(input[i])) {
            isInteger = 0;
            break;
        }
    }

    // -------- Integer Case --------
    if(isInteger) {
        int arr[50], n = 0;
        char *token = strtok(input, " ");

        while(token != NULL) {
            sscanf(token, "%d", &arr[n++]);
            token = strtok(NULL, " ");
        }

        int choice;
        printf("Integer detected!\n1. Insertion\n2. Selection\nChoose: ");
        scanf("%d", &choice);

        if(choice == 1)
            insertionSort(arr, n);
        else
            selectionSort(arr, n);

        printf("Sorted:\n");
        for(int i = 0; i < n; i++)
            printf("%d ", arr[i]);
    }

    // -------- Character Case --------
    else {
        char arr[50];
        int n = 0;

        for(int i = 0; input[i] != '\0'; i++) {
            if(input[i] != ' ' && input[i] != '\n')
                arr[n++] = input[i];
        }

        int choice;
        printf("Character detected!\n1. Bubble\n2. Quick\nChoose: ");
        scanf("%d", &choice);

        if(choice == 1)
            bubbleSort(arr, n);
        else
            quickSort(arr, 0, n - 1);

        printf("Sorted:\n");
        for(int i = 0; i < n; i++)
            printf("%c ", arr[i]);
    }

    return 0;
}
